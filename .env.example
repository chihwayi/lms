# Database Configuration
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=password
POSTGRES_DB=eduflow_dev
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=eduflow
DATABASE_PASSWORD=password
DATABASE_NAME=eduflow_dev
DATABASE_URL=postgresql://eduflow:password@postgres:5432/eduflow_dev

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# For local development: http://localhost:9000
# For production: http://your-domain.com:9000 or https://files.your-domain.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# API Configuration
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3006,http://localhost:3000

# Frontend Configuration
# URL of the API reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:3005
# URL of the API reachable from the Next.js server (SSR) - internal docker network
API_URL=http://api:3001

# Mail Configuration
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=ethereal.user@ethereal.email
MAIL_PASSWORD=ethereal_password
MAIL_FROM="EduFlow" <noreply@eduflow.com>
FRONTEND_URL=http://localhost:3006

# Monitoring
SENTRY_DSN=
