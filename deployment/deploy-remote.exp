#!/usr/bin/expect

set timeout -1
set host "173.212.195.88"
set user "root"
set password "b-4wB:cpC2i"
set local_path "."
set remote_path "/root/lms"

# Create remote directory
spawn ssh $user@$host "mkdir -p $remote_path"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}
expect eof

# Sync files using rsync
# Exclude heavy/unnecessary folders
spawn rsync -avz --exclude "node_modules" --exclude ".git" --exclude ".next" --exclude "dist" --exclude ".turbo" --exclude "coverage" --exclude ".env" -e ssh $local_path/ $user@$host:$remote_path/
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}
expect eof

# Run docker-compose on remote
spawn ssh $user@$host "cd $remote_path && docker-compose -f deployment/docker-compose.yml up --build -d"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}
# Allow plenty of time for build
set timeout 600
expect eof
